{
  "name": "datadjinn",
  "version": "0.1.24",
  "description": "AI-powered desktop database client",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prepare:jpype": "node scripts/backend-python.cjs backend/scripts/prepare_jpype_vendor.py",
    "build:backend": "npm run prepare:jpype && node scripts/backend-python.cjs backend/scripts/build_backend.py",
    "build:frontend": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build:backend && npm run build:frontend && electron-builder --dir",
    "build:win": "npm run build:win:all",
    "build:win:installer": "npm run build:backend && npm run build:frontend && electron-builder --win nsis",
    "build:win:zip": "npm run build:backend && npm run build:frontend && electron-builder --win zip",
    "build:win:all": "npm run build:backend && npm run build:frontend && electron-builder --win nsis zip --publish never",
    "build:mac": "npm run build:backend && npm run build:frontend && electron-builder --mac --publish never",
    "build:linux": "npm run build:backend && npm run build:frontend && electron-builder --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^6.4.3",
    "dompurify": "^3.3.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "marked": "^17.0.1",
    "monaco-editor": "^0.55.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
